	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>La aplicación requiere acceso a la cámara para capturar la imagen del documento de identidad del usuario, con el fin de validar su identidad durante el registro en la billetera digital.</string>
	<key>keychain-access-groups</key>
	<array>
	<key>NSFaceIDUsageDescription</key>
	<string>La aplicación utiliza Face ID para autenticar al usuario de forma segura en el acceso a la billetera digital.</string>
	<string>$(AppIdentifierPrefix)com.yata.wallet</string>
	</array>
</dict>
</plist>
